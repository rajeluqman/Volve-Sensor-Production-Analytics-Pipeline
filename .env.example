# ============================================================
# Volve Sensor & Production Analytics Pipeline — ENV Template
# Copy to .env and fill in your own credentials.
# NEVER commit .env to version control.
# ============================================================

# AWS
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_DEFAULT_REGION=ap-southeast-1
AWS_S3_LANDING_BUCKET=volve-landing
AWS_S3_BRONZE_BUCKET=volve-bronze
AWS_S3_SILVER_BUCKET=volve-silver

# Databricks
DATABRICKS_HOST=https://YOUR_WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=YOUR_DATABRICKS_PAT
DATABRICKS_WAREHOUSE_ID=YOUR_SQL_WAREHOUSE_ID
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/YOUR_SQL_WAREHOUSE_ID

# Snowflake
SNOWFLAKE_ACCOUNT=YOUR_ACCOUNT_IDENTIFIER
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_PASSWORD=YOUR_PASSWORD
SNOWFLAKE_DATABASE=VOLVE_DB
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=PUBLIC

# Snowflake MCP (Phase 8)
# Format URL: https://<SNOWFLAKE_ACCOUNT>.snowflakecomputing.com/api/v2/databases/VOLVE_DB/schemas/SERVING/mcp-servers/volve_mcp
SNOWFLAKE_MCP_URL=https://YOUR_ACCOUNT.snowflakecomputing.com/api/v2/databases/VOLVE_DB/schemas/SERVING/mcp-servers/volve_mcp
# PAT token — dapat dari: ALTER USER <user> ADD PROGRAMMATIC ACCESS TOKEN volve_mcp_token DAYS_TO_EXPIRY=90
SNOWFLAKE_PAT_TOKEN=YOUR_PAT_TOKEN

# Airflow (Docker)
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=YOUR_FERNET_KEY

# NiFi (optional — only if running NiFi ingestion)
NIFI_API_URL=https://localhost:8443/nifi-api
NIFI_USERNAME=admin
NIFI_PASSWORD=YOUR_NIFI_PASSWORD
